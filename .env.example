# Which settings module to use.
# Use 'config.settings.local' for development.
DJANGO_SETTINGS_MODULE=config.settings.local

# ==== Core ====
# Generate a new key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here
SALT_KEY=your-salt-key
DEBUG=True

# Comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Obfuscate the admin URL in production
ADMIN_URL=admin

# JSON array of [name, email] pairs — receives error emails
# Example: '[["Ursli", "ursli@example.com"]]'
ADMINS=[]

# ==== Database (production only) ====
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_HOST=localhost
DJANGO_DB_NAME=ddcs
DJANGO_DB_USER=ddcs
DJANGO_DB_PW=

# ==== Email ====
DJANGO_DEFAULT_FROM_EMAIL=DDCS <noreply@example.com>
DJANGO_SERVER_EMAIL=DDCS <noreply@example.com>
DJANGO_EMAIL_SUBJECT_PREFIX=[DDCS]

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Comma-separated list of origins that are allowed to POST (production)
# Example: https://ddcs.example.com
CSRF_TRUSTED_ORIGINS=

# ==== Static / Media (production only) ====
# STATIC_ROOT=/var/www/ddcs/staticfiles
# MEDIA_ROOT=/var/www/ddcs/media

# ==== TikTok Connection ====
# Portability API
AUTH_TOKEN_SECRET="some-secret-authli-uses-to-sign-state-token"
TIKTOK_CLIENT_ID="client-id"
TIKTOK_CLIENT_SECRET="client-secret"

# Research API
TIKTOK_RESEARCH_API_KEY=
TIKTOK_RESEARCH_API_SECRET=

# Reports — behaviour metrics reference population (per-participant CSV)
# Local example:
# BEHAVIOUR_METRICS_CSV_PATH=/Users/you/DFDW-2026-PREP/data/behaviour_metrics_per_participant.csv
# Production: place file at ddcs/reports/data/behaviour_metrics_per_participant.csv
BEHAVIOUR_METRICS_CSV_PATH=

# ==== Web analytics integration ====
ANALYTICS_SCRIPT_SRC=
ANALYTICS_WEBSITE_ID=

# ==== Celery & Redis ====
REDIS_DB=1
CELERY_DEFAULT_QUEUE="prod"
